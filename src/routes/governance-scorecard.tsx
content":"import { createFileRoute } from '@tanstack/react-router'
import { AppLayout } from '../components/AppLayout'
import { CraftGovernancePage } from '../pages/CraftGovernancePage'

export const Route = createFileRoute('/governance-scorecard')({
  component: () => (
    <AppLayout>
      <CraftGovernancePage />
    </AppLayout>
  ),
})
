content":"import { useMemo, useState } from 'react'
import { AlertTriangle, CheckCircle2, FileCheck2, ShieldAlert } from 'lucide-react'
import { Card, CardContent, CardHeader, CardTitle, ProgressBar, Table, Tbody, Td, Th, Thead } from '../components/ui'
import { CRAFT_CHECKLIST, calculateChecklistProgress } from '../lib/craft-platform'

export function CraftChecklistPage() {
  const [items, setItems] = useState(CRAFT_CHECKLIST)

  const progress = useMemo(() => calculateChecklistProgress(items), [items])

  const updateStatus = (id: string, status: ChecklistItem['status']) => {
    setItems(current => current.map(item => item.id === id ? { ...item, status } : item))
  }

  return (
    <div className="space-y-6">
      <div>
        <p className="text-xs font-semibold uppercase tracking-[0.18em] text-emerald-600">Checklist</p>
        <h1 className="mt-1 font-display text-3xl font-bold text-slate-900">IntegratED ESG Report Quality Checklist</h1>
      </div>

      <div className="grid gap-4 md:grid-cols-4">
        <Card>
          <CardContent className="pt-6">
            <p className="text-xs uppercase tracking-wide text-slate-500">Completion</p>
            <p className="mt-2 text-3xl font-bold text-slate-900">{progress.percentage}%</p>
          </CardContent>
        </Card>
        <Card>
          <CardContent className="pt-6">
            <p className="text-xs uppercase tracking-wide text-slate-500">Met</p>
            <p className="mt-2 text-3xl font-bold text-slate-900">{progress.met}</p>
          </CardContent>
        </Card>
        <Card>
          <CardContent className="pt-6">
            <p className="text-xs uppercase tracking-wide text-slate-500">Critical gaps</p>
            <p className="mt-2 text-3xl font-bold text-slate-900">{progress.critical}</p>
          </CardContent>
        </Card>
        <Card>
          <CardContent className="pt-6">
            <p className="text-xs uppercase tracking-wide text-slate-500">Awaiting verification</p>
            <p className="mt-2 text-3xl font-bold text-slate-900">{progress.awaiting}</p>
          </CardContent>
        </Card>
      </div>

      <Card>
        <CardHeader>
          <CardTitle className="flex items-center gap-2"><FileCheck2 className="h-4 w-4 text-emerald-600" /> 30-check report quality coverage</CardTitle>
        </CardHeader>
        <CardContent>
          <ProgressBar value={progress.percentage} className="mb-4" />
          <Table>
            <Thead>
              <tr>
                <Th>ID</Th>
                <Th>Check</Th>
                <Th>Owner</Th>
                <Th>Status</Th>
                <Th>Critical</Th>
              </tr>
            </Thead>
            <Tbody>
              {items.map(item => (
                <tr key={item.id}>
                  <Td>{item.id}</Td>
                  <Td>{item.title}</Td>
                  <Td>{item.owner}</Td>
                  <Td>
                    <select
                      className="rounded border border-slate-200 bg-white px-2 py-1 text-xs"
                      value={item.status}
                      onChange={e => updateStatus(item.id, e.target.value as any)}
                    >
                      <option value="Not started">Not started</option>
                      <option value="In progress">In progress</option>
                      <option value="Met">Met</option>
                      <option value="Partially met">Partially met</option>
                      <option value="Not met">Not met</option>
                      <option value="Not applicable">Not applicable</option>
                      <option value="Awaiting verification">Awaiting verification</option>
                      <option value="Blocked">Blocked</option>
                    </select>
                  </Td>
                  <Td>{item.critical ? <span className="inline-flex items-center gap-1 text-rose-600"><ShieldAlert className="h-3 w-3" /> Yes</span> : <span className="inline-flex items-center gap-1 text-emerald-600"><CheckCircle2 className="h-3 w-3" /> No</span>}</Td>
                </tr>
              ))}
            </Tbody>
          </Table>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle className="flex items-center gap-2"><AlertTriangle className="h-4 w-4 text-amber-600" /> Critical omission visibility</CardTitle>
        </CardHeader>
        <CardContent>
          <p className="text-sm text-slate-600">Critical omissions are shown separately so that an apparently high completion percentage cannot conceal a material failure.</p>
        </CardContent>
      </Card>
    </div>
  )
}




























































































































