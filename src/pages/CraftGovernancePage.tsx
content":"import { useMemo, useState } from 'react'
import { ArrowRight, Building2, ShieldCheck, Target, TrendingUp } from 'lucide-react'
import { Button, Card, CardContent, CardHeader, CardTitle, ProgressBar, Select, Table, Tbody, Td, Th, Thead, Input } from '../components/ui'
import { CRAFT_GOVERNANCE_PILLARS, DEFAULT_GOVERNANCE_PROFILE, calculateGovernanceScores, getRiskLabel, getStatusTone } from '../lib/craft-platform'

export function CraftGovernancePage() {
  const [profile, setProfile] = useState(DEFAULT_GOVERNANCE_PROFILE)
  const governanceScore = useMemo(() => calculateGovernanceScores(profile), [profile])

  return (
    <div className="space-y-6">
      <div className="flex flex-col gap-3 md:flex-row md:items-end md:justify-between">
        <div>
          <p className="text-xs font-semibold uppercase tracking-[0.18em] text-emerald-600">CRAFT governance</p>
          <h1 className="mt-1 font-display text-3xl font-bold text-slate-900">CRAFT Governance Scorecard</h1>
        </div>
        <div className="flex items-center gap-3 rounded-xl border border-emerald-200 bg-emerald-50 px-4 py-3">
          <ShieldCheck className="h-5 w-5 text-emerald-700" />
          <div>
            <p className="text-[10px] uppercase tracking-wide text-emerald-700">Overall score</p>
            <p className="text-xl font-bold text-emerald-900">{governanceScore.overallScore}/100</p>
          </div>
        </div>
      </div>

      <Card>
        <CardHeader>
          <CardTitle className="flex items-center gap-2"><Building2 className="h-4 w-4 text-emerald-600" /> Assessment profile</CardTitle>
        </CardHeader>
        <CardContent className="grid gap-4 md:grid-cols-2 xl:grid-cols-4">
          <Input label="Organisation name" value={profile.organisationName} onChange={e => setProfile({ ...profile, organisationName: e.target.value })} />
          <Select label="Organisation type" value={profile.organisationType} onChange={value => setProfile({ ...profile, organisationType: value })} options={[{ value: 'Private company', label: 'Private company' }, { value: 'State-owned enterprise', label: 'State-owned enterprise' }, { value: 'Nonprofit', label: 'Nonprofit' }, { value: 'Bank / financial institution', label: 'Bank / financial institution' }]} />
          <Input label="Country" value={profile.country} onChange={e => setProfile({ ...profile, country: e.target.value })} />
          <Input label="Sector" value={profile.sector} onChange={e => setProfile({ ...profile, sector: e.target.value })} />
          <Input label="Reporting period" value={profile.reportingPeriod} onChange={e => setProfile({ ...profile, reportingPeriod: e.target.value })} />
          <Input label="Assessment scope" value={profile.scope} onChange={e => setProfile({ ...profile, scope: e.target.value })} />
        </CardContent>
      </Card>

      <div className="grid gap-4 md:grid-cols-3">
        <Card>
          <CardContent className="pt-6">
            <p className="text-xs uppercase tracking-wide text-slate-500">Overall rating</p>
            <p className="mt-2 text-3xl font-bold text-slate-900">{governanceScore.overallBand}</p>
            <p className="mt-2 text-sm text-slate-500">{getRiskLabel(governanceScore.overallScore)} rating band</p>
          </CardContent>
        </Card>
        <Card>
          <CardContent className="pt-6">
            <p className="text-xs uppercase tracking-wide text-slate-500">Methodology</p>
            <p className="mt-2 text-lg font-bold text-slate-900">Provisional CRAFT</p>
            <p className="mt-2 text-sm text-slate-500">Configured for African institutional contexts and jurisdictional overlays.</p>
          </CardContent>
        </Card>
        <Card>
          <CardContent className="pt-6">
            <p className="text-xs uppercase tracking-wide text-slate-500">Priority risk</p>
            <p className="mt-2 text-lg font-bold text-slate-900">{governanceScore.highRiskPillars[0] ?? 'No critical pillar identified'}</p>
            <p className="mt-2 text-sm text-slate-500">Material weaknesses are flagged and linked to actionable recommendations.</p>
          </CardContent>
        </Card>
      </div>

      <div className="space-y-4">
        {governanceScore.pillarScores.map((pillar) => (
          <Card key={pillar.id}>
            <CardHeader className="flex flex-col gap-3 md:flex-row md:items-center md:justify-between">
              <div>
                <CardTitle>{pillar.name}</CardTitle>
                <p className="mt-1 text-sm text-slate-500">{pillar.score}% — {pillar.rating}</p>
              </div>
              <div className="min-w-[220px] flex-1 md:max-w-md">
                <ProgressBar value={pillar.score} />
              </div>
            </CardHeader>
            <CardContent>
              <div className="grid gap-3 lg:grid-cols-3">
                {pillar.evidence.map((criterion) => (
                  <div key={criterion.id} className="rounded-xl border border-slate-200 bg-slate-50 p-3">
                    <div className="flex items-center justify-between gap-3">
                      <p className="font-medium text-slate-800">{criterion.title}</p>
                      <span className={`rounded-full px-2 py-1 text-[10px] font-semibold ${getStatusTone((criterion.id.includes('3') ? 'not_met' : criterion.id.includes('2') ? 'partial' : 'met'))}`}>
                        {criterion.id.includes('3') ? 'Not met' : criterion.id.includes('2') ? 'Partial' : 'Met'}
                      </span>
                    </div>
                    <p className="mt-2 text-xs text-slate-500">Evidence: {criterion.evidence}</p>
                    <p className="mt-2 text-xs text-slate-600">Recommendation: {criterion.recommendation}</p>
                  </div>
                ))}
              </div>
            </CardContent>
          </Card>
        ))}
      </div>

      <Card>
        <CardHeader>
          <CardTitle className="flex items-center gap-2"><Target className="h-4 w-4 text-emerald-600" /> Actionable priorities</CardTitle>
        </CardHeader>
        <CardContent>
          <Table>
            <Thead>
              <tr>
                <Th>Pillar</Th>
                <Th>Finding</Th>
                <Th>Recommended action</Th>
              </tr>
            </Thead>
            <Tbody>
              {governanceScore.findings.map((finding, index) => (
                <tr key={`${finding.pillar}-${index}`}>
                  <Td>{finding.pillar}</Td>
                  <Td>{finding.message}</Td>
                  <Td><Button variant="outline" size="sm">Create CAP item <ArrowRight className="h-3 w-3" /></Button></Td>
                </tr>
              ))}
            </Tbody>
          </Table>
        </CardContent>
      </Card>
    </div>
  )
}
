    standard: index % 2 === 0 ? 'CRAFT / IFRS' : 'CRAFT / GRI',
    owner: ownerSequence[index % ownerSequence.length],
    status,
    critical: index % 5 === 0,
  }
})

export function calculateChecklistProgress(items: ChecklistItem[]) {
  const total = items.length
  const met = items.filter(item => item.status === 'Met').length
  const partial = items.filter(item => item.status === 'Partially met').length
  const awaiting = items.filter(item => item.status === 'Awaiting verification').length
  const critical = items.filter(item => item.status !== 'Met' && item.critical).length
  const percentage = total === 0 ? 0 : Math.round(((met + partial * 0.5) / total) * 100)

  return { total, met, partial, awaiting, critical, percentage }
}

