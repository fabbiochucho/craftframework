export type ImplementationPlan = {
  summary: string
  workstreams: Array<{ title: string; owner: string; timeline: string; deliverable: string; evidence: string }>
}

export function buildImplementationPlan(profile: Partial<GovernanceProfile>, selectedFrameworks: string[]): ImplementationPlan {
  const selected = selectedFrameworks.length ? selectedFrameworks : ['ifrs-s1-s2']
  const frameworkNames = selected.map(id => ESG_FRAMEWORKS.find(f => f.id === id)?.name ?? id)

  return {
    summary: `CRAFT implementation plan for ${profile.organisationName ?? 'your institution'} covering ${frameworkNames.join(', ')} across ${profile.reportingPeriod ?? 'the current reporting cycle'}.`,
    workstreams: [
      {
        title: 'Governance and accountability set-up',
        owner: 'Board / Company Secretary',
        timeline: '0-30 days',
        deliverable: 'Governance oversight model and reporting responsibilities',
        evidence: 'Board charter, reporting workflow, accountability matrix',
      },
      {
        title: 'Materiality and readiness assessment',
        owner: 'Sustainability lead',
        timeline: '30-90 days',
        deliverable: 'Materiality map and cross-framework gap analysis',
        evidence: 'Materiality assessment, governance scorecard and evidence register',
      },
      {
        title: 'Data, controls and reporting systems',
        owner: 'Finance and Compliance',
        timeline: '60-150 days',
        deliverable: 'Data dictionary, controls map and reporting workflow',
        evidence: 'Policy controls, management sign-offs, system mapping',
      },
      {
        title: 'Implementation and corrective action tracking',
        owner: 'Program manager',
        timeline: '90-240 days',
        deliverable: 'Closed corrective action plan with evidence verification',
        evidence: 'Corrective action log, milestone evidence, reviewer acceptance record',
      },
    ],
  }
}

