  const statusSequence: ChecklistItem['status'][] = ['Met', 'Partially met', 'In progress', 'Awaiting verification', 'Not started', 'Blocked', 'Not met', 'Not applicable']
  const ownerSequence = ['Board Secretary', 'Sustainability Lead', 'Finance Controller', 'Risk Manager', 'Compliance Officer']
  const status = statusSequence[index % statusSequence.length]

  return {
    id: `CK-${String(index + 1).padStart(2, '0')}`,
