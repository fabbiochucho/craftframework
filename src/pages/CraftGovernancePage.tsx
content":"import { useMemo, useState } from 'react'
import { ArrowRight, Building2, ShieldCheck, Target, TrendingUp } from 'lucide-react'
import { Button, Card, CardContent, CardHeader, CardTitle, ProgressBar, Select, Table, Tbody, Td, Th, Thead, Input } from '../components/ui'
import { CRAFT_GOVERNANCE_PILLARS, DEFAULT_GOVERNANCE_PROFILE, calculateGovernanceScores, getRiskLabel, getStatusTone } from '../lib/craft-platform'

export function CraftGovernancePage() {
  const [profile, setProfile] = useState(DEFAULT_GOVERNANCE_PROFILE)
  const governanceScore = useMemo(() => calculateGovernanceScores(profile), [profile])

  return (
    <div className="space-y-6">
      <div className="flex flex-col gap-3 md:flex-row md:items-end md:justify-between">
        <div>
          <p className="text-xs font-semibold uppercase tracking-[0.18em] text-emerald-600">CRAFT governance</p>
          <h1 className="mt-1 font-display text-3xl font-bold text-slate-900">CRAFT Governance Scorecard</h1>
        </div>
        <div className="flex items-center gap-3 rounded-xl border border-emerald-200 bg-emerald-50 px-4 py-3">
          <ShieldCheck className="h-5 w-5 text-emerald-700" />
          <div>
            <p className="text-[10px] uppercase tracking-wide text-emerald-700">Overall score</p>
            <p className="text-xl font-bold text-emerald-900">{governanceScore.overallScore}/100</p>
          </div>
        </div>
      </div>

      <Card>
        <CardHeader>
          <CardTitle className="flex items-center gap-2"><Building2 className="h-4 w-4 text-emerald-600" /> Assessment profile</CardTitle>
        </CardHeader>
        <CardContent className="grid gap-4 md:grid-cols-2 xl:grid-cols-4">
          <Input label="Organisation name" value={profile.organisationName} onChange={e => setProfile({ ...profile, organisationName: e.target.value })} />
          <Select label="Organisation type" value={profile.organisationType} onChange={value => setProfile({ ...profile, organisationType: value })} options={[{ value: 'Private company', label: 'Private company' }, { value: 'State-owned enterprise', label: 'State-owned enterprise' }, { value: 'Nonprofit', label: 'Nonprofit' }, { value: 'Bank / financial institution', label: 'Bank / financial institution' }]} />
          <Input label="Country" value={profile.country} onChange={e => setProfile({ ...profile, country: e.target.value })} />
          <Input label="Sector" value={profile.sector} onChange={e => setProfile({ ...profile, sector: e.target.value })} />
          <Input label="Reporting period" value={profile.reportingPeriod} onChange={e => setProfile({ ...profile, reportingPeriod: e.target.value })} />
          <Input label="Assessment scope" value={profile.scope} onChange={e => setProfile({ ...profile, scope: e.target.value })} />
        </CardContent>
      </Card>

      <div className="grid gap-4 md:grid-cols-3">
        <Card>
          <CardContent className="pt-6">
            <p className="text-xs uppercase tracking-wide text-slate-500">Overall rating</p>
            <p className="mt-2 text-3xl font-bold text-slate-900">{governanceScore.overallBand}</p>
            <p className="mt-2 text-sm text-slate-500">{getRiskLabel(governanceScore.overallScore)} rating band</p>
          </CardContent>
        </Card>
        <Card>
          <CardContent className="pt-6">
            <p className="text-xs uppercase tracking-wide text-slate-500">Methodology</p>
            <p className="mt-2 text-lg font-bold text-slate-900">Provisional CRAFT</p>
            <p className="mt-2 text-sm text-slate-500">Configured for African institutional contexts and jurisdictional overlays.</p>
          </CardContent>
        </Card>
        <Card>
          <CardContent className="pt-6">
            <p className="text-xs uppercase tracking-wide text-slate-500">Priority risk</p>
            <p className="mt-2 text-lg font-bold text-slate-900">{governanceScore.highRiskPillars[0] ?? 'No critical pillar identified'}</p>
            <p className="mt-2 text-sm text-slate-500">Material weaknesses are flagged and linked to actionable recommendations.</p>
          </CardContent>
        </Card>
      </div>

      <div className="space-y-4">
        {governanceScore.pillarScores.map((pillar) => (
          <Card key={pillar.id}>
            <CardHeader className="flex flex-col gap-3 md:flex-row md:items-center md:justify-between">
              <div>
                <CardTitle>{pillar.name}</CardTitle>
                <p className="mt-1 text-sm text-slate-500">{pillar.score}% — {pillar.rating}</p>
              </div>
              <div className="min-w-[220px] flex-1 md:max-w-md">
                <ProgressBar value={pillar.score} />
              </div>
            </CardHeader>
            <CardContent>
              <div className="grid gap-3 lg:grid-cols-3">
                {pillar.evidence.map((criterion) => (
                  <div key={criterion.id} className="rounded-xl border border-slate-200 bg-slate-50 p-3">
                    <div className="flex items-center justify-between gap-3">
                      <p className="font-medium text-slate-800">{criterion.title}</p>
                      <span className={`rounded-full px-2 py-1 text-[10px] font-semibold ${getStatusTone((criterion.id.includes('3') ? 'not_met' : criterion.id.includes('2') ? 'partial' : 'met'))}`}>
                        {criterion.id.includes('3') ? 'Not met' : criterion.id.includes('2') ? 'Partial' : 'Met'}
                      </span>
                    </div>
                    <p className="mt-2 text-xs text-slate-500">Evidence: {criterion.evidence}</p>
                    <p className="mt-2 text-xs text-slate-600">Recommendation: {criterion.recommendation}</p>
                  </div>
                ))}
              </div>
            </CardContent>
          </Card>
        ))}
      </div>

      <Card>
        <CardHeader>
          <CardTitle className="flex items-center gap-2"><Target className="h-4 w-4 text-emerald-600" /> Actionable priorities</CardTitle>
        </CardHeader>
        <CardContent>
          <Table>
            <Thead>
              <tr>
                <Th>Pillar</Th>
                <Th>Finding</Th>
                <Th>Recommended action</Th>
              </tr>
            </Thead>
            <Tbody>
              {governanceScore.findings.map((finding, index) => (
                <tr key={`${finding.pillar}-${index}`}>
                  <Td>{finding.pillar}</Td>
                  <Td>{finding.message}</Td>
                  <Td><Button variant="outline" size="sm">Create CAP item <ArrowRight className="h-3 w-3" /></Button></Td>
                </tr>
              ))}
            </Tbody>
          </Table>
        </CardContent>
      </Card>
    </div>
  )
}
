export const DEFAULT_GOVERNANCE_PROFILE: GovernanceProfile = {
  organisationName: 'Example Institution',
  organisationType: 'Private company',
  country: 'Nigeria',
  sector: 'Financial services',
  reportingPeriod: '2026',
  scope: 'Pan-African operations',
  frameworkSelection: ['IFRS S1 and IFRS S2', 'GRI Standards'],
}

export function calculateGovernanceScores(profile: Partial<GovernanceProfile> = DEFAULT_GOVERNANCE_PROFILE) {
  const responseMatrix: Record<string, GovernanceStatus> = {}
  for (const pillar of CRAFT_GOVERNANCE_PILLARS) {
    for (const criterion of pillar.criteria) {
      responseMatrix[criterion.id] = criterion.status
    }
  }

  const pillarScores = CRAFT_GOVERNANCE_PILLARS.map((pillar) => {
    const totalWeight = pillar.criteria.reduce((sum, criterion) => sum + criterion.weight, 0)
    const scoredWeight = pillar.criteria.reduce((sum, criterion) => {
      const statusScore = responseMatrix[criterion.id] === 'met' ? 1 : responseMatrix[criterion.id] === 'partial' ? 0.5 : 0
      return sum + criterion.weight * statusScore
    }, 0)

    const percentage = totalWeight === 0 ? 0 : (scoredWeight / totalWeight) * 100
    const rating = percentage >= 80 ? 'Strong' : percentage >= 65 ? 'Developing' : percentage >= 45 ? 'Watchlist' : 'High risk'

    return {
      id: pillar.id,
      name: pillar.name,
      score: Math.round(percentage),
      rating,
      weight: pillar.weight,
      evidence: pillar.criteria.map(c => ({ id: c.id, title: c.title, evidence: c.evidence, recommendation: c.recommendation })),
    }
  })

  const totalWeight = pillarScores.reduce((sum, p) => sum + p.weight, 0)
  const weightedScore = pillarScores.reduce((sum, p) => sum + (p.score * p.weight), 0)
  const overallScore = totalWeight === 0 ? 0 : Math.round(weightedScore / totalWeight)

  let overallBand = 'Provisional'
  if (overallScore >= 80) overallBand = 'Strong'
  else if (overallScore >= 65) overallBand = 'Developing'
  else if (overallScore >= 45) overallBand = 'Watchlist'
  else overallBand = 'High risk'

  const highRiskPillars = pillarScores.filter(p => p.score < 50).map(p => p.name)
  const findings = pillarScores
    .filter(p => p.score < 60)
    .map(p => ({ pillar: p.name, message: `Gap in ${p.name.toLowerCase()} requires corrective action.`, score: p.score }))

  return {
    profile: {
      organisationName: profile.organisationName ?? DEFAULT_GOVERNANCE_PROFILE.organisationName,
      organisationType: profile.organisationType ?? DEFAULT_GOVERNANCE_PROFILE.organisationType,
      country: profile.country ?? DEFAULT_GOVERNANCE_PROFILE.country,
      sector: profile.sector ?? DEFAULT_GOVERNANCE_PROFILE.sector,
      reportingPeriod: profile.reportingPeriod ?? DEFAULT_GOVERNANCE_PROFILE.reportingPeriod,
      scope: profile.scope ?? DEFAULT_GOVERNANCE_PROFILE.scope,
      frameworkSelection: profile.frameworkSelection ?? DEFAULT_GOVERNANCE_PROFILE.frameworkSelection,
    },
    overallScore,
    overallBand,
    pillarScores,
    highRiskPillars,
    findings,
    methodology: 'CRAFT provisional governance scoring methodology',
  }
}

