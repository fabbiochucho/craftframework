export function getRiskLabel(score: number) {
  if (score >= 80) return 'Strong'
  if (score >= 65) return 'Developing'
  if (score >= 45) return 'Watchlist'
  return 'High risk'
}

export function getStatusTone(status: GovernanceStatus) {
  if (status === 'met') return 'bg-emerald-100 text-emerald-700'
  if (status === 'partial') return 'bg-amber-100 text-amber-700'
  if (status === 'not_met') return 'bg-rose-100 text-rose-700'
  return 'bg-slate-100 text-slate-600'
}

export function getActionStatusTone(status: CorrectiveAction['status']) {
  if (status === 'Verified and Closed') return 'bg-emerald-100 text-emerald-700'
  if (status === 'Assigned' || status === 'In Progress') return 'bg-amber-100 text-amber-700'
  if (status === 'Submitted for Verification') return 'bg-sky-100 text-sky-700'
  if (status === 'Blocked') return 'bg-rose-100 text-rose-700'
  return 'bg-slate-100 text-slate-700'
}

export function estimateOperationalReadiness(frameworks: string[]) {
  if (!frameworks.length) return 'Startup'
  if (frameworks.length >= 4) return 'Advanced'
  if (frameworks.length >= 2) return 'Developing'
  return 'Initial'
}
