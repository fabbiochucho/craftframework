# Support Bot Configuration

# GitHub API token for creating issues (configure in Netlify; never commit a key)
GITHUB_TOKEN=<YOUR_GITHUB_TOKEN>

# SendGrid API key for report and support email delivery (configure in Netlify)
SENDGRID_API_KEY=<YOUR_SENDGRID_API_KEY>

# Email configuration
SUPPORT_EMAIL=craftframework@becomechange.institute
SENDGRID_FROM_EMAIL=noreply@craftframework.becomechange.institute

# Resend support escalation and existing invitations. Set real keys only in
# Netlify secrets or an untracked .env.local; verify custom sender domains.
RESEND_API_KEY=
INVITE_FROM_EMAIL=CRAFT <onboarding@resend.dev>

# Use a sender verified in Resend for production compliance notifications.
COMPLIANCE_FROM_EMAIL=
CCO_EMAIL=
CFO_EMAIL=

# Optional public-page translation gateway. Never expose these in VITE_ variables.
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=

# Specialized time-bound grants require Netlify Identity administrator access.
# Store the administrator token only in Netlify secrets.
NETLIFY_IDENTITY_ADMIN_TOKEN=
NETLIFY_IDENTITY_URL=

# Optional public PostHog project key (EU ingestion). Explicit widget consent
# is required; autocapture, replay, pageviews and workspace tracking are disabled.
VITE_POSTHOG_KEY=

# Dedicated disposable Postgres database; its name MUST contain "test".
# Integration/E2E tests DROP its public schema. Never use a deploy/preview DB.
TEST_DATABASE_URL=postgres://craft@127.0.0.1:5432/craft_test

# AES-256-GCM field encryption. Generate a random 32-byte key and base64 encode
# it outside the repository; configure the real value only in Netlify secrets.
FIELD_ENCRYPTION_KEY=<BASE64_ENCODED_32_BYTE_KEY>
FIELD_ENCRYPTION_KEY_VERSION=v1
# Optional JSON object mapping prior key versions to base64 keys during rotation.
FIELD_ENCRYPTION_PREVIOUS_KEYS={}

# Netlify Database uses the native platform adapter in db/index.ts.
# Provision the database on the Netlify site; a generic DATABASE_URL alone does
# not replace the adapter. Keep production and preview/test databases separate.

# Evidence/file storage uses Netlify Blobs (no configuration required on Netlify).
# Allowed CORS origins are fixed in netlify/lib/workspace.ts (ALLOWED_ORIGINS).
